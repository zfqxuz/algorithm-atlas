{
  "name": "algorithm-atlas-visualizer",
  "version": "3.0.0",
  "private": true,
  "description": "寻径·算法图谱：从本科基础到研究生难度的计算机可视化学习站",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zfqxuz/algorithm-atlas.git"
  },
  "homepage": "https://zfqxuz.github.io/algorithm-atlas/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build:standalone": "node build-standalone.js",
    "build": "node build-standalone.js && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:node": "node --test tests/*.test.js",
    "test:visuals": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test": "node --test tests/*.test.js && node node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@6.11.0"
}
